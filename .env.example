# App
APP_NAME=bookly
APP_ENV=dev
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
# Scalar UI at /docs. Spec: `make swagger` -> docs/swagger.json (not in git).
# prod: DOCS_USER and DOCS_PASSWORD are required, otherwise the app does not start.
DOCS_ENABLED=true
DOCS_SPEC_PATH=docs/swagger.json
DOCS_USER=
DOCS_PASSWORD=

# Postgres (PostGIS image required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bookly
POSTGRES_PASSWORD=bookly
POSTGRES_DB=bookly
POSTGRES_SSLMODE=disable
MIGRATIONS_DIR=migrations

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=change_me_to_32_plus_random_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
OTP_RESEND_COOLDOWN=1m
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
# MVP stub: every OTP is this code, nothing is really sent.
OTP_STATIC_CODE=1234

# Import CLI (go run ./cmd/command)
ZAPIS_BASE_URL=https://zapis.kz/rest/clients-app/v1
ZAPIS_ASSET_BASE_URL=https://zapis.kz
IMPORT_USER_AGENT=BooklyImporter/0.1
IMPORT_REQUEST_DELAY=500ms
